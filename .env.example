# Required: OpenRouter powers vision, reasoning, plans and prompt construction.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Required in production. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Image editor. "pollinations" works on its anonymous community tier for local evaluation.
# For production-grade private editing, use "fal" and provide FAL_KEY.
IMAGE_PROVIDER=pollinations
FAL_KEY=
POLLINATIONS_API_KEY=

# Public origin used by external image providers to fetch a short-lived signed source image.
# In development the request origin is used when omitted.
APP_URL=

# Optional deployment settings
DATABASE_PATH=./data/hearthform.db
MAX_UPLOAD_MB=10
NODE_ENV=development
